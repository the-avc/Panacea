# ===================================================================
# PANACEA CONSULTANCY — Production & Staging Environment Specification
# ===================================================================
# IMPORTANT: This template contains VARIABLE NAMES ONLY.
# NEVER commit real credentials, passwords, secret keys, or tokens.
# Production secrets MUST be provisioned via deployment secret managers.
# ===================================================================

# ---- Application Environment ----
NODE_ENV=
PORT=
APP_URL=
PORTAL_URL=
API_URL=
APP_WEB_ORIGIN=
APP_PORTAL_ORIGIN=

# ---- Database (PostgreSQL 16) ----
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=
DATABASE_LOGGING=

# ---- Session / Security Secrets ----
SESSION_SECRET=
SESSION_MAX_AGE_MS=
ADMIN_SESSION_MAX_AGE_MS=
SESSION_IDLE_TIMEOUT_MS=
ADMIN_SESSION_IDLE_TIMEOUT_MS=

# ---- Password Hashing & Parameters ----
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# ---- Multi-Factor Authentication (MFA) ----
MFA_ISSUER=
WEBAUTHN_RP_NAME=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ---- Object Storage (AWS S3 / MinIO Private Storage) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_EXPIRY_SECONDS=
REQUIRE_STORAGE_READY=

# ---- Malware Scanning (ClamAV TCP Daemon) ----
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_ENABLED=

# ---- Distributed Rate Limiting (Redis Cluster) ----
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---- CORS & Network Access ----
CORS_ORIGINS=

# ---- Security Headers & Reporting ----
CSP_REPORT_URI=

# ---- Audit Logging & Monitoring ----
LOG_LEVEL=
AUDIT_LOG_ENABLED=

# ---- Document Upload Restrictions ----
MAX_FILE_SIZE_BYTES=
ALLOWED_MIME_TYPES=
