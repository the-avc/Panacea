# ===================================================================
# Institutional Platform — Environment Variables
# ===================================================================
# IMPORTANT: This file contains ONLY placeholder variable names.
# NEVER commit actual credentials, API keys, or secrets.
# Copy this file to .env and fill in real values locally.
# ===================================================================

# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORTAL_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# ---- Database (PostgreSQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=platform_db
DATABASE_USER=platform_app
DATABASE_PASSWORD=CHANGE_ME_LOCALLY
DATABASE_SSL=false
DATABASE_LOGGING=false

# ---- Session / Authentication ----
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_MAX_AGE_MS=28800000
ADMIN_SESSION_MAX_AGE_MS=14400000
SESSION_IDLE_TIMEOUT_MS=1800000
ADMIN_SESSION_IDLE_TIMEOUT_MS=900000

# ---- Password Hashing ----
# Using argon2 — rounds/memory configurable
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ---- MFA ----
MFA_ISSUER=SecuredPlatform
WEBAUTHN_RP_NAME=Secured Creditor Platform
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# ---- Object Storage (S3-compatible / MinIO for dev) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=secured-documents
S3_ACCESS_KEY=CHANGE_ME_LOCALLY
S3_SECRET_KEY=CHANGE_ME_LOCALLY
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRY_SECONDS=300

# ---- Malware Scanning ----
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# ---- Email (Contact Form & Notifications) ----
EMAIL_PROVIDER=console
EMAIL_API_KEY=CHANGE_ME_LOCALLY
EMAIL_FROM=noreply@example.com
CONTACT_NOTIFICATION_EMAIL=notifications@example.com

# ---- Rate Limiting ----
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_TTL_SECONDS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Security Headers ----
CSP_REPORT_URI=

# ---- Logging & Monitoring ----
LOG_LEVEL=debug
AUDIT_LOG_ENABLED=true

# ---- File Upload Limits ----
MAX_FILE_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png
