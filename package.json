{
  "name": "panacea",
  "version": "0.1.0",
  "private": true,
  "description": "Panacea Consultancy Private Limited — Digital Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:security": "turbo test:security",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo clean",
    "db:migrate": "pnpm --filter @panacea/api db:migrate",
    "db:seed": "pnpm --filter @panacea/api db:seed",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "prepare": "echo 'Hooks ready'"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.4.5"
  }
}
